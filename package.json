{
  "name": "my-farmhouse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typegen": "sanity schema extract --enforce-required-fields --force --path sanity.schema.json && sanity typegen generate",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "check-env": "node --env-file=.env.local scripts/check-env.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "screenshots": "node scripts/take-screenshots.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.102",
    "@ai-sdk/react": "^4.0.152",
    "@base-ui/react": "^1.9.0",
    "@clerk/nextjs": "^7.9.18",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.20.0",
    "ai": "^7.0.148",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "next-sanity": "^13.3.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanity": "^6.20.0",
    "stripe": "^23.0.0",
    "styled-components": "^6.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@clerk/testing": "^2.2.49",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^29.1.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@vercel/frameworks": {
      "js-yaml": "^3.15.2",
      "smol-toml": "^1.9.1"
    },
    "typeid-js": {
      "uuid": "^11.1.1"
    }
  }
}

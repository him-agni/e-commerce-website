# Copy to .env.local and fill in. Never commit .env.local.

# Sanity (https://www.sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Editor token: used by the seed script and the Stripe webhook
SANITY_API_WRITE_TOKEN=

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe, test mode only (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the dashboard webhook endpoint when deployed
STRIPE_WEBHOOK_SECRET=

# Google AI Studio key for the Gemini assistant (https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=

# Unsplash Access Key, used only by the seed script to fetch stock photos (https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=

# Site URL, used for Stripe redirect URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opt out of Clerk SDK telemetry (optional)
CLERK_TELEMETRY_DISABLED=1
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1
